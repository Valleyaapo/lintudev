---
import { projects } from '../data/projects';

const previews = projects.slice(0, 3);
---

<section class="relative overflow-hidden border-b border-border">
  <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-[60vh] h-[60vh] bg-primary rounded-full blur-[150px] translate-x-1/3 -translate-y-1/4 opacity-[0.14]"></div>
    <div class="absolute bottom-0 left-0 w-[45vh] h-[45vh] bg-lime rounded-full blur-[140px] -translate-x-1/3 translate-y-1/2 opacity-[0.06]"></div>
    <div
      class="absolute inset-0 opacity-[0.05]"
      style="background-image: linear-gradient(to right, #40D0FF 1px, transparent 1px), linear-gradient(to bottom, #40D0FF 1px, transparent 1px); background-size: 4rem 4rem; mask-image: radial-gradient(ellipse at 70% 40%, black 20%, transparent 75%);"
    ></div>
  </div>

  <div class="container relative z-10 grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-8 items-center pt-16 pb-14 md:pt-24 md:pb-24 lg:min-h-[78vh]">
    <div>
      <p class="eyebrow mb-6 reveal" style="--i:0">/// Lintu Dev Studio</p>

      <h1 class="text-[2.75rem] leading-[0.95] sm:text-6xl lg:text-7xl xl:text-[5.5rem] font-extrabold tracking-[-0.04em] mb-6 md:mb-8 reveal" style="--i:1">
        Native apps for <span class="text-primary">everyday</span> Finland.
      </h1>

      <p class="text-lg md:text-xl text-text-muted max-w-xl mb-8 md:mb-10 leading-relaxed reveal" style="--i:2">
        A small studio shipping iOS apps and real-time web products, from live
        Finnish transit to art flashcards. Designed, built and maintained in-house.
      </p>

      <div class="flex flex-wrap gap-3 reveal" style="--i:3">
        <a href="#work" class="btn-primary">See the work</a>
        <a href="#contact" class="btn-outline">Start a project</a>
      </div>
    </div>

    <div class="relative h-[260px] sm:h-[340px] lg:h-[440px] hidden sm:block" aria-hidden="true">
      {previews.map((project, idx) => (
        <a
          href={`/project/${project.id}`}
          tabindex="-1"
          class:list={[
            'hero-card absolute w-[78%] aspect-video rounded-xl overflow-hidden border border-white/10 shadow-2xl shadow-black/50 reveal',
            idx === 0 && 'right-0 top-[30%] z-30',
            idx === 1 && 'right-[14%] top-[6%] z-20',
            idx === 2 && 'right-[26%] top-[54%] z-10',
          ]}
          style={`--i:${idx + 2}; --r:${[-2, 3, -5][idx]}deg`}
        >
          <img
            src={`/assets/${project.id}-card.webp`}
            alt=""
            width="1200"
            height="675"
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-card {
    rotate: var(--r);
    transition: rotate 0.3s ease, scale 0.3s ease;
  }
  .hero-card:hover {
    rotate: 0deg;
    scale: 1.03;
    z-index: 40;
  }
</style>
