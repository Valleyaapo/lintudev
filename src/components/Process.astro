---
// Proof, not process: concrete facts from the shipped products.
const facts = [
  {
    value: '3',
    label: 'Products shipped',
    detail: 'Two native iOS apps and a real-time web platform.',
  },
  {
    value: '6',
    label: 'Transit regions',
    detail: 'Linjalla covers HSL, Tampere, Turku, Oulu, Kuopio and Jyväskylä.',
  }
];
---

<section class="section container pt-20 md:pt-28">
  <h2 class="text-3xl md:text-4xl font-bold mb-10 md:mb-12">Shipped</h2>

  <div class="grid gap-px bg-border border border-border rounded-xl overflow-hidden sm:grid-cols-2">
    {facts.map((fact) => (
      <div class="bg-bg p-6 md:p-8">
        <span class="block font-display text-6xl md:text-7xl font-extrabold text-primary leading-none mb-4 tracking-[-0.04em]">
          {fact.value}
        </span>
        <span class="block font-semibold mb-2">{fact.label}</span>
        <p class="text-text-muted text-sm leading-relaxed">{fact.detail}</p>
      </div>
    ))}
  </div>
</section>
