---
const services = [
  { title: 'Native iOS', detail: 'Swift, SwiftUI, MapKit, SwiftData' },
  { title: 'Web apps', detail: 'React, Astro, Next.js, Node.js' },
  { title: 'Real-time data & maps', detail: 'GTFS Realtime, WebSockets, live feeds' },
  { title: 'UI engineering', detail: 'Design systems, motion, accessibility' },
  { title: 'Backend & APIs', detail: 'PostgreSQL, serverless, third-party integrations' },
];
---

<section id="services" class="section container pt-20 md:pt-28 scroll-mt-20">
  <div class="grid gap-8 md:gap-12 md:grid-cols-[1fr_2fr]">
    <div>
      <h2 class="text-3xl md:text-4xl font-bold">Capabilities</h2>
    </div>

    <ul class="border-t border-border">
      {services.map((item, idx) => (
        <li class="group py-5 md:py-6 border-b border-border grid grid-cols-[2.5rem_1fr] md:grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 gap-y-1">
          <span class="text-primary text-xs font-mono">{String(idx + 1).padStart(2, '0')}</span>
          <span class="font-display text-xl md:text-2xl font-semibold transition-colors group-hover:text-primary">{item.title}</span>
          <span class="col-start-2 md:col-start-3 text-sm text-text-muted font-mono">{item.detail}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
